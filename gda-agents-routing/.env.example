# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# LLM Model 
ROUTER_MODEL="gemini-3.5-flash-lite"

# Gemini Data Analytics Project and Agents
GDA_AGENTS_BILLING_PROJECT=
GDA_AGENTS_LOCATION=
AGENTS_FILTER=
MAX_EXAMPLES=
A2A_HISTORY_LENGTH=

# Prompt - Response Logging Locally 
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT="EVENT_ONLY"
OTEL_SEMCONV_STABILITY_OPT_IN="gen_ai_latest_experimental"
OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT="jsonl"
OTEL_INSTRUMENTATION_GENAI_UPLOAD_BASE_PATH="gs://your-dev-project-id-your-project-name-logs/completions"
OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK="upload"
LOGS_BUCKET_NAME="your-dev-project-id-your-project-name-logs" 

# BigQuery Agent Analytics Plugin 
BQ_ANALYTICS_DATASET_ID=
BQ_ANALYTICS_LOCATION=us
BQ_ANALYTICS_CONNECTION_ID=us.biglake-us
BQ_ANALYTICS_GCS_BUCKET=""